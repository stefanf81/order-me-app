{
  "name": "order-me-app",
  "private": true,
  "version": "5.3.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:size": "node scripts/check-bundle-size.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lean-qr": "2.7.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "knip": "^6.41.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
